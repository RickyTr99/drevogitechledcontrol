<UserControl x:Class="DrevogitechLedControl.Pages.KeyboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:DrevogitechLedControl.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,28,36,36" MaxWidth="1000">
            <TextBlock Text="Tastiera" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="Drevo Tyrfing V2 · illuminazione RGB" Style="{StaticResource SettingHint}" FontSize="14" Margin="0,2,0,20" />

            <!-- Preview / per-key editor -->
            <Border Style="{StaticResource Card}" Padding="12">
                <StackPanel>
                    <c:KeyboardCanvas x:Name="Board" />
                    <StackPanel x:Name="PerKeyTools" Margin="4,12,4,0">
                        <!-- tools wrap onto more lines when the window is narrow -->
                        <DockPanel>
                            <Button DockPanel.Dock="Right" x:Name="FillAll" Content="Riempi tutto" Click="FillAll_Click"
                                    VerticalAlignment="Top" Margin="12,0,0,0" />
                            <WrapPanel>
                                <TextBlock Text="Pennello" Style="{StaticResource SettingLabel}" Margin="0,0,10,0" />
                                <c:ColorButton x:Name="BrushButton" Margin="0,0,12,0" />
                                <WrapPanel x:Name="QuickSwatches" VerticalAlignment="Center" Margin="0,4" />
                            </WrapPanel>
                        </DockPanel>
                        <TextBlock Style="{StaticResource SettingHint}" Margin="0,10,0,0"
                                   Text="Clic o trascina per colorare · clic destro per prendere il colore di un tasto" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="Effetto" Style="{StaticResource SectionTitle}" />

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" MinWidth="140" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE790;" Margin="0,0,16,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Modalità" Style="{StaticResource SettingLabel}" />
                        <TextBlock Text="Effetto di illuminazione della tastiera" Style="{StaticResource SettingHint}" />
                    </StackPanel>
                    <ComboBox Grid.Column="2" x:Name="ModeBox" Width="260" SelectionChanged="Setting_Changed" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" x:Name="Color1Row">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" MinWidth="140" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE2B1;" Margin="0,0,16,0" />
                    <TextBlock Grid.Column="1" Text="Colore principale" Style="{StaticResource SettingLabel}" />
                    <c:ColorButton Grid.Column="2" x:Name="Color1Button" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" x:Name="Color2Row">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" MinWidth="140" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE2B1;" Margin="0,0,16,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Colore secondario" Style="{StaticResource SettingLabel}" />
                        <TextBlock Text="Usato dagli effetti a due colori" Style="{StaticResource SettingHint}" />
                    </StackPanel>
                    <c:ColorButton Grid.Column="2" x:Name="Color2Button" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" x:Name="RainbowRow">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" MinWidth="140" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE706;" Margin="0,0,16,0" />
                    <CheckBox Grid.Column="1" x:Name="RainbowSwitch" Style="{StaticResource ToggleSwitch}" Click="Setting_Changed">
                        <StackPanel>
                            <TextBlock Text="Arcobaleno" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="Usa tutti i colori invece del colore scelto" Style="{StaticResource SettingHint}" />
                        </StackPanel>
                    </CheckBox>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" MinWidth="140" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE706;" Margin="0,0,16,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Luminosità" Style="{StaticResource SettingLabel}" />
                        <TextBlock Text="La tastiera supporta 6 livelli" Style="{StaticResource SettingHint}" />
                    </StackPanel>
                    <Slider Grid.Column="2" x:Name="BrightnessSlider" Width="300" Minimum="0" Maximum="6"
                            SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="1" TickPlacement="BottomRight"
                            VerticalAlignment="Center" ValueChanged="Slider_Changed" />
                    <TextBlock Grid.Column="3" x:Name="BrightnessValue" Style="{StaticResource SettingLabel}" HorizontalAlignment="Right" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" x:Name="SpeedRow">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" MinWidth="140" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xEC4A;" Margin="0,0,16,0" />
                    <TextBlock Grid.Column="1" Text="Velocità" Style="{StaticResource SettingLabel}" />
                    <Slider Grid.Column="2" x:Name="SpeedSlider" Width="300" Minimum="0" Maximum="9"
                            IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" ValueChanged="Slider_Changed" />
                    <TextBlock Grid.Column="3" x:Name="SpeedValue" Style="{StaticResource SettingLabel}" HorizontalAlignment="Right" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" x:Name="DirectionRow">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" MinWidth="140" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8AB;" Margin="0,0,16,0" />
                    <TextBlock Grid.Column="1" Text="Direzione" Style="{StaticResource SettingLabel}" />
                    <ComboBox Grid.Column="2" x:Name="DirectionBox" Width="260" SelectionChanged="Setting_Changed" />
                </Grid>
            </Border>

            <TextBlock Text="Profili salvati" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" MinWidth="140" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8F1;" Margin="0,0,16,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Configurazioni della tastiera" Style="{StaticResource SettingLabel}" />
                        <TextBlock Text="Salva l'illuminazione attuale per richiamarla in seguito" Style="{StaticResource SettingHint}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <ComboBox x:Name="ProfileBox" Width="200" />
                        <Button Content="Carica" Margin="8,0,0,0" Click="LoadProfile_Click" />
                        <Button Content="Salva come…" Margin="8,0,0,0" Click="SaveProfile_Click" Style="{DynamicResource AccentButtonStyle}" />
                        <Button Margin="8,0,0,0" Click="DeleteProfile_Click" ToolTip="Elimina profilo">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
