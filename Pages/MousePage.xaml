<UserControl x:Class="DrevogitechLedControl.Pages.MousePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="36,28,36,24" MaxWidth="1000">
                <TextBlock Text="Mouse" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="Subtitle" Text="Logitech G502 HERO" Style="{StaticResource SettingHint}" FontSize="14" Margin="0,2,0,20" />

                <Border x:Name="NotConnected" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Margin="0,0,16,0" />
                        <TextBlock Style="{StaticResource SettingLabel}" Text="Mouse non trovato. Collegalo: verrà rilevato automaticamente." />
                    </StackPanel>
                </Border>

                <StackPanel x:Name="Body">
                    <!-- Lighting -->
                    <TextBlock Text="Illuminazione" Style="{StaticResource SectionTitle}" Margin="2,0,0,8" />
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" MinWidth="140" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" Margin="0,0,16,0" />
                            <CheckBox Grid.Column="1" x:Name="SyncSwitch" Style="{StaticResource ToggleSwitch}" Click="Sync_Click">
                                <StackPanel>
                                    <TextBlock Text="Sincronizza con la tastiera" Style="{StaticResource SettingLabel}" />
                                    <TextBlock Text="Il mouse segue colore, effetto e luminosità della tastiera" Style="{StaticResource SettingHint}" />
                                </StackPanel>
                            </CheckBox>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}" x:Name="BalanceRow">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" MinWidth="140" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE706;" Margin="0,0,16,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Bilanciamento luminosità" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="Regola finché mouse e tastiera sembrano ugualmente luminosi (prova a livelli diversi della tastiera)" Style="{StaticResource SettingHint}" />
                            </StackPanel>
                            <Grid Grid.Row="1" Grid.Column="1" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Mouse più scuro" Style="{StaticResource SettingHint}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <Slider Grid.Column="1" x:Name="BalanceSlider" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                        IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="Balance_Changed" />
                                <TextBlock Grid.Column="2" Text="più luminoso" Style="{StaticResource SettingHint}" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </Grid>
                        </Grid>
                    </Border>
                    <StackPanel x:Name="ZonesPanel" />
                    <Border Style="{StaticResource Card}" x:Name="DpiAlwaysOnRow">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" MinWidth="140" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7C9;" Margin="0,0,16,0" />
                            <CheckBox Grid.Column="1" x:Name="DpiAlwaysOnSwitch" Style="{StaticResource ToggleSwitch}" Click="DpiAlwaysOn_Click">
                                <StackPanel>
                                    <TextBlock Text="Indicatore DPI sempre acceso" Style="{StaticResource SettingLabel}" />
                                    <TextBlock Text="Se disattivato si accende solo per qualche secondo quando cambi DPI (impostazione salvata nel mouse)" Style="{StaticResource SettingHint}" />
                                </StackPanel>
                            </CheckBox>
                        </Grid>
                    </Border>

                    <!-- DPI -->
                    <TextBlock Text="Sensibilità" Style="{StaticResource SectionTitle}" />
                    <Border x:Name="DpiWarning" Visibility="Collapsed" CornerRadius="8" Padding="16,12" Margin="0,0,0,8" BorderThickness="1"
                            Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" MinWidth="140" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Margin="0,0,16,0" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Nessun pulsante può cambiare i DPI" Style="{StaticResource SettingLabel}" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource SettingHint}" Text="Hai più livelli DPI, ma nessun tasto è impostato su DPI su / giù / a ciclo (sotto, in Pulsanti)." />
                            </StackPanel>
                            <Button Grid.Column="2" Content="Usa G9 per scorrere i DPI" Click="AssignDpiButtons_Click" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" MinWidth="140" /></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7C9;" Margin="0,0,16,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Livelli DPI" Style="{StaticResource SettingLabel}" />
                                    <TextBlock Text="Fino a 5 livelli, da scorrere con i tasti DPI del mouse" Style="{StaticResource SettingHint}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel x:Name="DpiRows" Margin="32,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" MinWidth="140" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7C9;" Margin="0,0,16,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Livello all'accensione" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="DPI usati quando il mouse viene collegato" Style="{StaticResource SettingHint}" />
                            </StackPanel>
                            <ComboBox Grid.Column="2" x:Name="DefaultDpiBox" Width="200" SelectionChanged="Profile_Changed" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" MinWidth="140" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE1D9;" Margin="0,0,16,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="DPI Shift (sniper)" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="Livello attivo finché tieni premuto il tasto sniper" Style="{StaticResource SettingHint}" />
                            </StackPanel>
                            <ComboBox Grid.Column="2" x:Name="ShiftDpiBox" Width="200" SelectionChanged="Profile_Changed" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" MinWidth="140" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;" Margin="0,0,16,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Frequenza di polling" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="Quante volte al secondo il mouse comunica la sua posizione" Style="{StaticResource SettingHint}" />
                            </StackPanel>
                            <ComboBox Grid.Column="2" x:Name="RateBox" Width="200" SelectionChanged="Profile_Changed" />
                        </Grid>
                    </Border>

                    <!-- Buttons -->
                    <Grid>
                        <TextBlock Text="Pulsanti" Style="{StaticResource SectionTitle}" />
                        <Button Content="Ripristina tasti di fabbrica" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,8"
                                Click="FactoryButtons_Click" />
                    </Grid>
                    <Border Style="{StaticResource Card}" Padding="16,8">
                        <StackPanel x:Name="ButtonRows" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Save bar -->
        <Border Grid.Row="1" x:Name="SaveBar" BorderThickness="0,1,0,0" Padding="36,12"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="140" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="DirtyText" Style="{StaticResource SettingHint}" VerticalAlignment="Center" FontSize="13"
                           Text="Le modifiche a DPI, polling e pulsanti vengono salvate nella memoria del mouse e funzionano anche senza questa app." />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="RevertButton" Content="Annulla modifiche" Click="Revert_Click" IsEnabled="False" />
                    <Button x:Name="SaveButton" Content="Salva nel mouse" Margin="8,0,0,0" Click="Save_Click" IsEnabled="False"
                            Style="{DynamicResource AccentButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
